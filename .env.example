# ── Required ────────────────────────────────────────────────────────────────
# Base URL of your Remnawave panel (no trailing slash needed).
REMNAWAVE_BASE_URL=https://panel.example.com
# Remnawave panel API token (sent as "Authorization: Bearer ...").
REMNAWAVE_API_TOKEN=
# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# ── Admin & flows (optional) ──────────────────────────────────────────────────
# Admin Telegram user ID(s) for payment/invite/register flows. Comma-separated
# for multiple admins. 0 (or empty) disables the payment flows.
TELEGRAM_ADMIN_ID=0

# ── Telegram message format (optional) ───────────────────────────────────────
# HTML / MarkdownV2 / empty.
TELEGRAM_PARSE_MODE=HTML

# ── Scheduler (optional) ──────────────────────────────────────────────────────
# IANA timezone for the daily run.
TZ=Europe/Moscow
# Local time of the daily run (HH:MM).
RUN_AT=09:00
# Run the notification job immediately on start.
RUN_ON_START=true

# ── Win-back after expiry (optional) ─────────────────────────────────────────
# Send "subscription expired" win-back messages after the expiry date.
WINBACK_ENABLED=true
# Days AFTER expiry to send the win-back message (comma-separated).
WINBACK_DAYS=1,3

# ── Language & currency (optional) ───────────────────────────────────────────
# Bot chat language: ru / en (the Mini App frontend stays Russian).
BOT_LANG=ru
# Currency label shown next to tariff prices.
CURRENCY=₽

# ── Telegram Mini App (optional) ─────────────────────────────────────────────
# Public HTTPS URL of the Mini App (empty = mini app off). Requires a reverse
# proxy in front terminating TLS and forwarding to WEBAPP_LISTEN.
WEBAPP_URL=
# Local bind address for the mini app server (behind your reverse proxy).
WEBAPP_LISTEN=:8080

# ── Platega payment gateway (optional) ───────────────────────────────────────
# Online payments via Platega (SBP / cards) as an alternative to the manual P2P
# flow. Leave the credentials empty to keep P2P-only (default, unchanged
# behaviour). When configured, an admin switches the active provider at runtime
# from the bot admin menu or the Mini App admin panel — no restart needed.
#
# The webhook server reuses the Mini App HTTP server (WEBAPP_LISTEN). In the
# Platega merchant dashboard set the notification (webhook) URL to:
#   https://<your-public-host>/platega/callback
# It must be reachable through your reverse proxy. The server starts when either
# WEBAPP_URL or the Platega credentials below are set.
#
# Merchant id and secret from the Platega dashboard (both required to enable it).
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Payment method: sbp (СБП) or card. Default: sbp.
PLATEGA_METHOD=sbp
# ISO currency code sent to the Platega API (distinct from the CURRENCY label).
PLATEGA_CURRENCY=RUB
# Where Platega returns the user after payment (e.g. your bot deep link).
PLATEGA_RETURN_URL=https://t.me

# ── Storage & runtime (optional) ─────────────────────────────────────────────
# SQLite database file path.
DB_PATH=/data/bot.db
# Log instead of sending to Telegram / panel.
DRY_RUN=false
# debug / info / warn / error.
LOG_LEVEL=info
# HTTP request timeout (Go duration, e.g. 15s).
HTTP_TIMEOUT=15s
