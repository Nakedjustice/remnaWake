# ── Required ────────────────────────────────────────────────────────────────
# Base URL of your Remnawave panel (no trailing slash needed).
REMNAWAVE_BASE_URL=https://panel.example.com
# Remnawave panel API token (sent as "Authorization: Bearer ...").
REMNAWAVE_API_TOKEN=
# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# ── Admin & flows (optional) ──────────────────────────────────────────────────
# Admin Telegram user ID(s) for payment/invite/register flows. Comma-separated
# for multiple admins. 0 (or empty) disables the payment flows.
TELEGRAM_ADMIN_ID=0

# ── Telegram message format (optional) ───────────────────────────────────────
# HTML / MarkdownV2 / empty.
TELEGRAM_PARSE_MODE=HTML

# ── Scheduler (optional) ──────────────────────────────────────────────────────
# IANA timezone for the daily run.
TZ=Europe/Moscow
# Local time of the daily run (HH:MM).
RUN_AT=09:00
# Run the notification job immediately on start.
RUN_ON_START=true

# ── Win-back after expiry (optional) ─────────────────────────────────────────
# Send "subscription expired" win-back messages after the expiry date.
WINBACK_ENABLED=true
# Days AFTER expiry to send the win-back message (comma-separated).
WINBACK_DAYS=1,3
#
# Users can mute expiry reminders and/or win-back messages independently from
# the "🔔 Notifications" button in the bot menu — no configuration needed.

# ── Scheduled database backup (optional) ─────────────────────────────────────
# Send a compacted copy of the SQLite database (bot.db) to every admin's
# Telegram DM during the daily job, at most once per DB_BACKUP_INTERVAL_DAYS
# days. Admins can also request a copy anytime with /backup. Restore a saved
# file on the server with: ./install.sh restore <file>.
DB_BACKUP_ENABLED=false
# Minimum days between scheduled backups (positive integer).
DB_BACKUP_INTERVAL_DAYS=1

# ── Free trial (optional) ────────────────────────────────────────────────────
# Let a brand-new user (one with no linked profile) create a trial profile that
# lasts TRIAL_DAYS days, once per Telegram ID. Off by default. When enabled, a
# "🎁 Try for free" button appears in the menu, the /trial command works, and a
# claim card shows in the Mini App. These values are the initial defaults only:
# an admin can toggle the trial and change its length at runtime from the bot
# admin menu or the Mini App admin panel (the override persists across restarts).
TRIAL_ENABLED=false
# Trial length in days (positive integer). Required when TRIAL_ENABLED is true.
TRIAL_DAYS=3
# Total traffic allowance for the whole trial in GB. 0 means unlimited.
TRIAL_TRAFFIC_LIMIT_GB=10
# Maximum devices for a trial profile. 0 means unlimited.
TRIAL_HWID_DEVICE_LIMIT=1
# Optional dedicated internal-squad UUID for trial profiles. Empty inherits the
# normal default squad. Admin runtime settings override these initial defaults.
TRIAL_SQUAD_UUID=
# Require admin approval before a trial is created for a NEW user who arrived
# WITHOUT a referral. Referred users (brought in via a referral link) still get
# the instant trial. When on, such a request is queued and every admin gets
# approve/reject buttons. Off by default; toggle at runtime from the bot admin
# menu or the Mini App admin panel (the override persists across restarts).
TRIAL_REQUIRE_APPROVAL=false

# ── Referral bonus (optional) ────────────────────────────────────────────────
# Reward referrals made through the invite flow: when an admin approves an
# invite, the inviter gets bonus days on their own subscription and the invitee
# gets extra days on top of the 1-month invite term. Off by default. At least
# one of the two bonuses must be positive when REFERRAL_ENABLED is true. Like the
# trial, these are initial defaults: admins can toggle and edit the bonuses at
# runtime from the bot admin menu or the Mini App admin panel.
REFERRAL_ENABLED=false
# Bonus days added to the inviter's own subscription per approved invite.
REFERRAL_INVITER_BONUS_DAYS=30
# Extra days granted to the newly invited user on top of the invite term.
REFERRAL_INVITEE_BONUS_DAYS=0

# ── Language & currency (optional) ───────────────────────────────────────────
# Bot chat language: ru / en (the Mini App frontend stays Russian).
BOT_LANG=ru
# Currency label shown next to tariff prices.
CURRENCY=₽

# ── Telegram Mini App (optional) ─────────────────────────────────────────────
# Public HTTPS URL of the Mini App (empty = mini app off). Requires a reverse
# proxy in front terminating TLS and forwarding to WEBAPP_LISTEN.
WEBAPP_URL=
# Local bind address for the mini app server (behind your reverse proxy).
WEBAPP_LISTEN=:8080

# ── Platega payment gateway (optional) ───────────────────────────────────────
# Online payments via Platega (SBP / cards) as an alternative to the manual P2P
# flow. Leave the credentials empty to keep P2P-only (default, unchanged
# behaviour). When configured, an admin switches the active provider at runtime
# from the bot admin menu or the Mini App admin panel — no restart needed.
#
# The webhook server reuses the Mini App HTTP server (WEBAPP_LISTEN). In the
# Platega merchant dashboard set the notification (webhook) URL to:
#   https://<your-public-host>/platega/callback
# It must be reachable through your reverse proxy. The server starts when either
# WEBAPP_URL or the Platega credentials below are set.
#
# Merchant id and secret from the Platega dashboard (both required to enable it).
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Payment method: sbp (СБП) or card. Default: sbp.
PLATEGA_METHOD=sbp
# ISO currency code sent to the Platega API (distinct from the CURRENCY label).
PLATEGA_CURRENCY=RUB
# Where Platega returns the user after payment (e.g. your bot deep link).
PLATEGA_RETURN_URL=https://t.me

# ── Telegram Stars (optional) ────────────────────────────────────────────────
# Native in-app Telegram Stars (XTR) payments. Uses the bot's own token — no
# extra credentials and no webhook (confirmation arrives via getUpdates). Enable
# it, then turn it on in the admin "Payment methods" picker. Several providers
# (p2p / platega / telegram_stars) can be enabled at once; when more than one is
# enabled the user chooses at checkout.
TELEGRAM_STARS_ENABLED=false
# Conversion rate: how many price units (in the CURRENCY unit, e.g. RUB) equal
# one Star. The Stars charged for a tariff is ceil(price / rate). Required (a
# positive integer) when TELEGRAM_STARS_ENABLED is true.
TELEGRAM_STARS_RATE=

# ── Auto-update (optional) ───────────────────────────────────────────────────
# When enabled, the bot polls the container registry for a new image and DMs the
# admins when a newer version of AUTOUPDATE_IMAGE is published. Off by default.
AUTOUPDATE_ENABLED=false
# Image reference watched for new manifest digests (registry/repo:tag).
AUTOUPDATE_IMAGE=ghcr.io/nakedjustice/remnawave:main
# How often to check the registry (Go duration, e.g. 6h).
AUTOUPDATE_CHECK_INTERVAL=6h
# One-tap install: when a Watchtower sidecar runs in HTTP-API mode, the "Install
# now" button calls it to pull the new image and recreate the container. Leave
# WATCHTOWER_URL empty for notify-only (the button then shows manual upgrade
# instructions). See docker-compose.yml for the sidecar definition.
WATCHTOWER_URL=
WATCHTOWER_TOKEN=

# ── Xray Checker proxy monitoring (optional) ─────────────────────────────────
# Runs a separate kutovoys/xray-checker sidecar that probes connectivity through
# each proxy in a subscription and exposes the result on /metrics. The bot polls
# it to show per-proxy health in the /admin menu and the Mini App admin panel,
# and DMs admins when a proxy goes down or recovers. Off by default.
#
# XRAY_CHECKER_URL empty = disabled. The installer sets it to the in-compose
# service name; both containers share the compose project's default network.
XRAY_CHECKER_URL=
# Basic-auth credentials for the checker's /metrics (METRICS_PROTECTED=true).
XRAY_CHECKER_USERNAME=
XRAY_CHECKER_PASSWORD=
# How often the bot polls the checker for status changes (Go duration, e.g. 2m).
XRAY_CHECKER_POLL_INTERVAL=2m
# Consumed by the sidecar (not the bot): the subscription it probes and the
# probe method (ip / status / download).
XRAY_CHECKER_SUB_URL=
XRAY_CHECKER_METHOD=ip
# Public URL of the checker's own roomy web dashboard. When set, admins get a
# button (bot /admin menu, proxy-health card, and the Mini App proxy tab) that
# opens it, and they can also open the URL directly in a browser. It stays
# admin-only because the dashboard sits behind the same basic auth as /metrics
# (METRICS_PROTECTED=true). Independent of XRAY_CHECKER_URL — the link works even
# if the bot does not poll /metrics. Empty = no link.
#   Same domain as the Mini App: reverse-proxy the sidecar under a sub-path and
#   set the sidecar's METRICS_BASE_PATH to the same prefix. The dashboard is then
#   served at the prefix WITH a trailing slash (the bare path 301-redirects), e.g.
#     XRAY_CHECKER_PUBLIC_URL=https://bot.example.com/checker/
#     XRAY_CHECKER_URL=http://xray-checker:2112/checker    (must include the prefix)
#   Or point it at any standalone URL you proxy to the sidecar yourself.
XRAY_CHECKER_PUBLIC_URL=

# ── Storage & runtime (optional) ─────────────────────────────────────────────
# SQLite database file path.
DB_PATH=/data/bot.db
# Log instead of sending to Telegram / panel.
DRY_RUN=false
# debug / info / warn / error.
LOG_LEVEL=info
# HTTP request timeout (Go duration, e.g. 15s).
HTTP_TIMEOUT=15s
